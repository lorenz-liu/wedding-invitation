# Environment Variables
# Copy this file to .env and fill in your actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# API Endpoint (update this after deploying CloudFormation stack)
API_ENDPOINT=https://your-lambda-url.lambda-url.us-east-1.on.aws/

# WeChat Mini Program App ID (for cloud storage of audio files)
WECHAT_APP_ID=your_wechat_app_id

# Tencent Map API Key
TENCENT_MAP_KEY=your_tencent_map_key
