# Optional overrides for local scripts (init-tablestore, upload-oss)

OSS_REGION=oss-cn-chengdu
OSS_BUCKET=wedding-asset
TABLESTORE_ENDPOINT=https://wedding.cn-chengdu.ots.aliyuncs.com
TABLESTORE_INSTANCE=wedding
TABLESTORE_TABLE=guests

# SMS (FC function env vars — set in console or before `s deploy`)
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# After FC deploy, set in src/constants/aliyun.ts:
# ALIYUN_FC_BASE_URL=https://your-function.cn-chengdu.fcapp.run

# Auth: do NOT create long-lived AccessKey. See infra/aliyun/SETUP.md
# - CloudShell: automatic
# - Local CLI: aliyun configure --mode OAuth
# - Cloud SSO: aliyun configure --mode CloudSSO
# Optional fallback only:
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
