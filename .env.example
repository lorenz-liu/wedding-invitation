# Environment Variables
# Copy this file to .env and fill in your actual values

# Cloudflare (optional — primary config is src/constants/cloudflare.ts)
CLOUDFLARE_PUBLIC_BASE_URL=https://your-worker.workers.dev

# Tencent Map API Key
TENCENT_MAP_KEY=your_tencent_map_key

# Cloudflare Worker secrets (set via wrangler secret put in infra/cloudflare/)
# SMS_SECRET_ID=
# SMS_SECRET_KEY=
# SMS_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=
