{
  "name": "wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding electronic invitation",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "check:biome": "biome check --write .",
    "check:biome:ci": "biome check .",
    "upload:oss-assets": "node scripts/upload-oss-assets.mjs",
    "upload:oss-file": "node scripts/upload-oss-file.mjs",
    "upload:oss-webp": "node scripts/upload-oss-webp.mjs",
    "convert:webp": "bash scripts/convert-images-to-webp.sh",
    "convert:webp:install": "bash scripts/convert-images-to-webp.sh --install",
    "report:image-bytes": "node scripts/report-preload-image-bytes.mjs",
    "deploy:aliyun": "node scripts/deploy-fc.mjs",
    "deploy:aliyun:s": "npm install --prefix infra/aliyun/fc && cd infra/aliyun && pnpm exec s deploy -y",
    "s:config": "node scripts/sync-s-config.mjs",
    "db:init-tablestore": "node scripts/init-tablestore.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
