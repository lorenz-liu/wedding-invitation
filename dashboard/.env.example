# Aliyun — defaults match the wedding project; override only if needed.
# TABLESTORE_ENDPOINT=https://wedding.cn-chengdu.ots.aliyuncs.com
# TABLESTORE_INSTANCE=wedding
# TABLESTORE_TABLE=guests
# DRAWINGS_OSS_REGION=oss-cn-chengdu
# DRAWINGS_OSS_BUCKET=guest-drawings

# Local only: leave DASHBOARD_PASSWORD unset to skip the login screen.
# DASHBOARD_PASSWORD=

# Aliyun auth — pick one (local default: `aliyun configure --profile wedding`):
# ALIBABA_CLOUD_PROFILE=wedding
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
